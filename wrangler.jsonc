{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-management-api",
  "main": "worker/entry.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node tools/check-deployment-config.mjs && node tools/build-assets.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "task-management-db", "database_id": "81918d83-4f0e-4827-baa6-042b890efeeb" }],
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } }
}
