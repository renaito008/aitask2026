{
  "name": "task2026-local-only",
  "main": "worker/entry.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node tools/build-assets.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "task2026-local-only", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } }
}
